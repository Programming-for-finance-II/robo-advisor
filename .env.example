# ============================================================
# Environment variables — copy this file to .env and fill in
# ============================================================
# cp .env.example .env

# Anthropic API key — required for the LLM Narrator (/advice endpoint)
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# FastAPI backend API key — protects all /profile /optimize /advice endpoints
# Set any strong random string (e.g. openssl rand -hex 32).
# If left empty, auth is DISABLED (development mode only — never in production).
API_KEY=
